.container {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  padding-top: env(safe-area-inset-top);
  position: relative;
}

.publish-types {
  display: flex;
  background: #fff;
  padding: 20rpx 32rpx 24rpx;
  margin-top: 48rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
  transition: all 0.3s ease;
}

.type-item.active {
  background: linear-gradient(135deg, #3366ff 0%, #5588ff 100%);
  box-shadow: 0 4rpx 16rpx rgba(51,102,255,0.3);
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.type-item.active .type-name {
  color: #fff;
}

.form-scroll {
  height: calc(100vh - 220rpx);
  padding: 24rpx;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.form-section {
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3366ff;
}

.section-required {
  font-size: 22rpx;
  color: #999;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #3366ff;
  background: #fff;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-textarea.large {
  height: 280rpx;
}

.form-textarea:focus {
  border-color: #3366ff;
  background: #fff;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-item.half {
  flex: 1;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #bbb;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
  transform: rotate(90deg);
}

.type-pills {
  display: flex;
  gap: 16rpx;
}

.type-pill {
  flex: 1;
  text-align: center;
  padding: 20rpx 16rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.type-pill.active {
  background: #3366ff;
  color: #fff;
  font-weight: 500;
}

.timeline-list {
  margin-bottom: 28rpx;
}

.timeline-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.timeline-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #3366ff;
}

.timeline-delete {
  font-size: 24rpx;
  color: #ff4d4f;
}

.timeline-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 10rpx;
  font-size: 26rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.timeline-input:last-child {
  margin-bottom: 0;
}

.timeline-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.timeline-add:active {
  border-color: #3366ff;
  color: #3366ff;
}

.add-icon {
  font-size: 32rpx;
  font-weight: bold;
}

.rating-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.rating-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.rating-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.rating-stars {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.star {
  font-size: 40rpx;
  color: #ddd;
  transition: all 0.2s ease;
}

.star.active {
  color: #ffb800;
}

.rating-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #3366ff;
}

.tag-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag-chip {
  padding: 10rpx 20rpx;
  background: #f0f2f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tag-chip:active {
  background: #3366ff;
  color: #fff;
}

.anonymous-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.anonymous-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.anonymous-hint {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.submit-area {
  padding: 32rpx 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #3366ff 0%, #5588ff 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(51,102,255,0.3);
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-icon {
  font-size: 36rpx;
}

.disclaimer {
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.6;
}