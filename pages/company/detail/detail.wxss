.container {
  min-height: 100vh;
  background: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.content-scroll {
  min-height: 100vh;
  padding-bottom: 100rpx;
  padding-top: 48rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.company-header {
  display: flex;
  padding: 32rpx;
  background: #ffffff;
  align-items: center;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.company-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f5f5f7;
  margin-right: 24rpx;
  border: 1rpx solid #e0e0e0;
}

.company-logo image {
  width: 100%;
  height: 100%;
}

.company-info {
  flex: 1;
}

.company-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

.company-stage {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: block;
}

.company-location {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: block;
}

.company-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: #f0f4ff;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #3366ff;
}

.company-profile {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.profile-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.rating-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.rating-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 20rpx;
}

.rating-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
}

.rating-score {
  font-size: 48rpx;
  font-weight: 700;
  color: #3366ff;
}

.rating-count {
  font-size: 24rpx;
  color: #999999;
  white-space: nowrap;
}

.rating-details {
  margin-bottom: 32rpx;
}

.rating-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.rating-label {
  font-size: 24rpx;
  color: #666666;
  min-width: 120rpx;
}

.rating-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
  min-width: 60rpx;
}

.rating-bar {
  flex: 1;
  height: 12rpx;
  background: #f5f5f7;
  border-radius: 6rpx;
  overflow: hidden;
}

.rating-fill {
  height: 100%;
  background: linear-gradient(90deg, #3366ff 0%, #668fff 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.company-stats {
  display: flex;
  justify-content: space-around;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  transition: all 0.3s ease;
}

.stat-item:hover {
  transform: translateY(-4rpx);
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #3366ff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666666;
}

.content-tabs {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item:hover {
  color: #3366ff;
}

.tab-item.active {
  color: #3366ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: #3366ff;
  border-radius: 2rpx;
}

.content-list {
  min-height: 500rpx;
  padding: 20rpx 32rpx;
}

.content-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.content-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.08);
  border-color: #e0e9ff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  line-height: 1.4;
  margin-right: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-type {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.type-interview {
  background: #e8f0fe;
  color: #3366ff;
}

.type-salary {
  background: #f0f9ff;
  color: #0ea5e9;
}

.type-review {
  background: #fef3c7;
  color: #f59e0b;
}

.card-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 20rpx;
  color: #999999;
  background: #f5f5f7;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.meta-item.status-success {
  background: #f6ffed;
  color: #52c41a;
}

.meta-item.status-danger {
  background: #fff1f0;
  color: #ff4d4f;
}

.meta-item.status-info {
  background: #e6f7ff;
  color: #1890ff;
}

.card-content {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.interview-list .content-card {
  min-height: 280rpx;
  padding: 32rpx;
}

.interview-list .card-content {
  -webkit-line-clamp: 4;
  margin-bottom: 20rpx;
  min-height: auto;
}

.salary-list .content-card {
  min-height: 250rpx;
  padding: 32rpx;
}

.review-list .content-card {
  min-height: 300rpx;
  padding: 32rpx;
}

.review-list .card-content {
  -webkit-line-clamp: 6;
  margin-bottom: 20rpx;
  min-height: auto;
}

.pros-text {
  display: block;
  margin-bottom: 16rpx;
  color: #52c41a;
  line-height: 1.5;
}

.cons-text {
  display: block;
  color: #ff4d4f;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.salary-info {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.salary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #0ea5e9;
  margin-right: 8rpx;
}

.salary-unit {
  font-size: 24rpx;
  color: #666666;
}

.review-rating {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.rating-label {
  font-size: 24rpx;
  color: #666666;
}

.rating-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #f59e0b;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.truth-score {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-label {
  font-size: 20rpx;
  color: #999999;
}

.score-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #3366ff;
}

.stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stat-item {
  font-size: 20rpx;
  color: #666666;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 12rpx;
  display: block;
  color: #333333;
}

.empty-hint {
  font-size: 24rpx;
  display: block;
  color: #666666;
}