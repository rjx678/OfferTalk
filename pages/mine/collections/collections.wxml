<view class="container">
  <custom-nav title="我的收藏" back="{{true}}" background="#3366ff" color="#ffffff"></custom-nav>

  <scroll-view scroll-y class="content-scroll">
    <view class="empty-state" wx:if="{{!hasCollections}}">
      <text class="empty-icon">⭐</text>
      <text class="empty-title">暂无收藏内容</text>
      <text class="empty-desc">收藏喜欢的内容，随时查看</text>
    </view>

    <view class="collect-list" wx:else>
      <view class="collect-item" wx:for="{{collectList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-type="{{item.type}}">
        <view class="collect-type" wx:if="{{item.typeName}}">{{item.typeName}}</view>
        <text class="collect-title">{{item.title}}</text>
        <text class="collect-content">{{item.content}}</text>
        <view class="collect-footer">
          <text class="collect-time">{{item.createTime}}</text>
          <view class="collect-btns">
            <text class="collect-btn" catchtap="handleCancel" data-id="{{item.id}}">取消收藏</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>