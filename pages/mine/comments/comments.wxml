<view class="container">
  <custom-nav title="我的评论" back="{{true}}" background="#3366ff" color="#ffffff"></custom-nav>

  <scroll-view scroll-y class="content-scroll">
    <view class="empty-state" wx:if="{{!hasComments}}">
      <text class="empty-icon">💬</text>
      <text class="empty-title">暂无评论内容</text>
      <text class="empty-desc">发表你的看法，参与讨论吧</text>
    </view>

    <view class="comment-list" wx:else>
      <view class="comment-item" wx:for="{{commentList}}" wx:key="id" bindtap="goDetail" data-id="{{item.contentId}}" data-type="{{item.contentType}}">
        <view class="comment-header">
          <image class="comment-avatar" src="{{item.avatarUrl || '/images/default-avatar.jpeg'}}" mode="aspectFill" />
          <view class="comment-meta">
            <text class="comment-nickname">{{item.nickname}}</text>
            <text class="comment-time">{{item.createTime}}</text>
          </view>
        </view>
        <text class="comment-content">{{item.content}}</text>
        <view class="comment-target">
          <text class="target-label">评论于：</text>
          <text class="target-title">{{item.postTitle}}</text>
          <text class="target-arrow">›</text>
        </view>
        <view class="comment-footer">
          <view class="footer-item">
            <text class="footer-icon">💬</text>
            <text class="footer-text">{{item.replyCount || 0}}</text>
          </view>
          <view class="footer-item">
            <text class="footer-icon">👍</text>
            <text class="footer-text">{{item.likeCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>