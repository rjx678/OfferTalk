.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  padding-top: env(safe-area-inset-top);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.user-section {
  padding: 24rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-top: 48rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.user-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #f5f5f7;
  margin-right: 28rpx;
  border: 4rpx solid #f0f4ff;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.user-bio {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.user-stats {
  font-size: 24rpx;
  color: #666666;
}

.user-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.badge-icon {
  font-size: 48rpx;
}

.login-card {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.login-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.login-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #f5f5f7;
  margin-right: 24rpx;
  border: 2rpx solid #e0e0e0;
}

.login-text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.login-subtext {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  padding: 0 24rpx 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f0f0f0;
  flex: 1;
  margin: 0 8rpx;
  transition: all 0.3s ease;
}

.stat-item:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
  border-color: #e0e9ff;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #3366ff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666666;
}

.content-section {
  padding: 0 24rpx 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.content-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.content-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.content-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
  border-color: #e0e9ff;
}

.content-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.card-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.card-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 6rpx;
}

.card-count {
  font-size: 22rpx;
  color: #999999;
}

.action-section {
  padding: 0 24rpx 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.action-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.action-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
  border-color: #e0e9ff;
}

.action-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.action-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.action-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.menu-section {
  padding: 0 24rpx 24rpx;
}

.setting-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f0f0f0;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.3s ease;
}

.setting-item:hover {
  background: #f8f9fa;
  transform: translateX(8rpx);
}

.setting-item:active {
  background: #f0f4ff;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.setting-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.setting-arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

.app-footer {
  padding: 48rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #3366ff;
  margin-bottom: 6rpx;
}

.app-version {
  font-size: 24rpx;
  color: #999999;
}

.disclaimer {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
}