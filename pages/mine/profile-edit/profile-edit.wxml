<view class="container">
  <custom-nav title="编辑资料" back="{{true}}" background="#3366ff" color="#ffffff"></custom-nav>

  <scroll-view scroll-y class="content-scroll">
    <!-- 头像编辑 -->
    <view class="section">
      <view class="avatar-section">
        <view class="avatar-wrapper" bindtap="changeAvatar">
          <image class="avatar" src="{{formData.avatarUrl || '/images/default-avatar.jpeg'}}" mode="aspectFill" />
          <view class="avatar-mask">
            <text class="camera-icon">📷</text>
            <text class="change-text">更换头像</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 基本信息编辑 -->
    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="settings-card">
        <view class="form-item">
          <text class="form-label">昵称</text>
          <input class="form-input" placeholder="请输入昵称" value="{{formData.nickname}}" bindinput="onInputChange" data-field="nickname" maxlength="20" />
        </view>
        <view class="form-item">
          <text class="form-label">手机号</text>
          <text class="form-value">{{formData.phone || '未绑定'}}</text>
        </view>
        <view class="form-item no-border">
          <text class="form-label">个人简介</text>
        </view>
        <view class="bio-wrapper">
          <textarea class="bio-input" placeholder="介绍一下自己吧..." value="{{formData.bio}}" bindinput="onInputChange" data-field="bio" maxlength="100" />
          <text class="bio-count">{{formData.bio ? formData.bio.length : 0}}/100</text>
        </view>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="section">
      <view class="section-title">数据统计</view>
      <view class="settings-card">
        <view class="stats-grid">
          <view class="stat-item">
            <text class="stat-value">{{profile.totalPostCount || 0}}</text>
            <text class="stat-label">发布</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{profile.totalLikeCount || 0}}</text>
            <text class="stat-label">获赞</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{profile.totalCollectCount || 0}}</text>
            <text class="stat-label">收藏</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{profile.totalCommentCount || 0}}</text>
            <text class="stat-label">评论</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-btn" bindtap="saveProfile">保存修改</view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
