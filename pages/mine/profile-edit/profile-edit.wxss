.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-top: env(safe-area-inset-top);
}

.content-scroll {
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
  padding-top: 0;
}

.section {
  margin: 20rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.settings-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.avatar-section {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.avatar-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background-color: #f0f0f0;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.avatar-wrapper:active .avatar-mask {
  opacity: 1;
}

.camera-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.change-text {
  font-size: 24rpx;
  color: #ffffff;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item.no-border {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
  margin-left: 24rpx;
}

.form-value {
  font-size: 28rpx;
  color: #999999;
  margin-left: 24rpx;
}

.bio-wrapper {
  padding: 24rpx 32rpx;
  position: relative;
}

.bio-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.bio-count {
  position: absolute;
  right: 40rpx;
  bottom: 32rpx;
  font-size: 24rpx;
  color: #999999;
}

.stats-grid {
  display: flex;
  padding: 32rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #3366ff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.save-btn {
  margin: 40rpx 32rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #3366ff, #6699ff);
  color: #ffffff;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
}

.bottom-space {
  height: 100rpx;
}
