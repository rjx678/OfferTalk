<view class="container">
  <custom-nav title="我的点赞" back="{{true}}" background="#3366ff" color="#ffffff"></custom-nav>

  <scroll-view scroll-y class="content-scroll">
    <view class="empty-state" wx:if="{{!hasLikes}}">
      <text class="empty-icon">👍</text>
      <text class="empty-title">暂无点赞内容</text>
      <text class="empty-desc">点赞喜欢的内容，支持作者</text>
    </view>

    <view class="like-list" wx:else>
      <view class="like-item" wx:for="{{likeList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-type="{{item.type}}">
        <view class="like-type" wx:if="{{item.typeName}}">{{item.typeName}}</view>
        <text class="like-title">{{item.title}}</text>
        <text class="like-content">{{item.content}}</text>
        <view class="like-footer">
          <text class="like-time">{{item.createTime}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>