.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 180rpx;
  padding-top: env(safe-area-inset-top);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.search-section {
  background: #fff;
  padding: 20rpx 32rpx 24rpx;
  margin-top: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f6f8;
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
}

.search-box icon {
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.category-nav {
  display: flex;
  background: #fff;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f5f6f8;
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #3366ff 0%, #5588ff 100%);
  box-shadow: 0 4rpx 16rpx rgba(51,102,255,0.3);
}

.category-icon {
  font-size: 36rpx;
}

.category-item.active .category-icon {
  transform: scale(1.1);
}

.category-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.category-item.active .category-text {
  color: #fff;
  font-weight: 600;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #fff;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-section {
  display: flex;
  gap: 12rpx;
}

.filter-option {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f6f8;
  transition: all 0.3s ease;
}

.filter-option.active {
  background: #3366ff;
  color: #ffffff;
}

.divider {
  width: 1rpx;
  height: 28rpx;
  background: #e0e0e0;
  margin: 0 8rpx;
}

.company-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #3366ff;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 24rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
  margin-left: auto;
}

.company-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.company-icon {
  font-size: 24rpx;
}

.content-list {
  height: calc(100vh - 500rpx);
  padding: 20rpx 32rpx;
}

.content-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.3s ease;
  border: 1rpx solid #f0f0f0;
}

.content-card:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  border-color: #e0e9ff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.company-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.company-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f5f5f7;
  border: 1rpx solid #e0e0e0;
}

.company-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.company-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.job-title {
  font-size: 24rpx;
  color: #666666;
}

.type-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.type-interview {
  background: #e8f0fe;
  color: #3366ff;
}

.type-salary {
  background: #f0f9ff;
  color: #0ea5e9;
}

.type-review {
  background: #fef3c7;
  color: #f59e0b;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-content {
  margin-bottom: 20rpx;
}

.content-preview {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.interview-meta, .salary-meta, .review-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 20rpx;
  color: #999999;
  background: #f5f5f7;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.meta-item.rating {
  color: #f59e0b;
  background: #fef3c7;
  font-weight: 500;
}

.salary-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.salary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #0ea5e9;
}

.salary-unit {
  font-size: 24rpx;
  color: #666666;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.truth-score {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-label {
  font-size: 20rpx;
  color: #999999;
}

.score-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #3366ff;
}

.stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  justify-content: center;
}

.stat-item {
  font-size: 20rpx;
  color: #666666;
}

.time {
  font-size: 20rpx;
  color: #999999;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #666666;
}

.disclaimer {
  background: #f5f5f7;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #e0e0e0;
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  z-index: 99;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
  text-align: center;
}