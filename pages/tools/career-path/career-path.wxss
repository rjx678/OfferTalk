.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-top: env(safe-area-inset-top);
}

.content-scroll {
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
  padding-top: 48rpx;
}

.section {
  background-color: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #666;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  margin-left: 16rpx;
  color: #999;
}

.time-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.time-option {
  padding: 16rpx 32rpx;
  background-color: #f0f0f0;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
}

.time-option.active {
  background-color: #3366ff;
  color: #fff;
}

.generate-btn {
  margin: 40rpx 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #3366ff, #6699ff);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
}

.result-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.path-overview {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #f0f5ff, #e6eeff);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.path-start, .path-end {
  flex: 1;
  text-align: center;
}

.path-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.path-position {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.path-arrow {
  font-size: 48rpx;
  color: #3366ff;
  margin: 0 20rpx;
}

.path-duration {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background-color: #3366ff;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.stages-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stage-card {
  padding: 24rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 16rpx;
}

.stage-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.stage-number {
  background-color: #3366ff;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.stage-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.stage-duration {
  font-size: 26rpx;
  color: #999;
}

.stage-objectives {
  margin-bottom: 16rpx;
}

.objectives-label {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.objectives-list {
  margin-top: 8rpx;
}

.objective-item {
  display: block;
  font-size: 26rpx;
  color: #333;
  padding: 8rpx 0;
}

.objective-item::before {
  content: '• ';
  color: #3366ff;
}

.stage-skills {
  margin-bottom: 16rpx;
}

.skills-label {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.skills-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.skill-tag {
  padding: 8rpx 20rpx;
  background-color: #f0f5ff;
  color: #3366ff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.stage-milestone {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.milestone-icon {
  margin-right: 12rpx;
}

.milestone-text {
  font-size: 26rpx;
  color: #333;
}

.gap-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.gap-card {
  padding: 24rpx;
  border-radius: 16rpx;
}

.gap-card.missing {
  background-color: #fff5f5;
}

.gap-card.improve {
  background-color: #f5fff5;
}

.gap-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.gap-icon {
  margin-right: 12rpx;
}

.gap-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.gap-content {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.gap-item {
  padding: 8rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #333;
}

.gap-empty {
  font-size: 26rpx;
  color: #999;
  font-style: italic;
}

.resources-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.resource-card {
  padding: 24rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 16rpx;
}

.resource-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.resource-type {
  padding: 8rpx 16rpx;
  background-color: #3366ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.resource-rating {
  font-size: 26rpx;
  color: #ff9500;
}

.resource-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.resource-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.resource-platform {
  font-size: 26rpx;
  color: #999;
  margin-right: 20rpx;
}

.resource-duration {
  font-size: 26rpx;
  color: #999;
}

.resource-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.resource-action {
  text-align: center;
  padding: 16rpx;
  background-color: #f0f5ff;
  border-radius: 12rpx;
}

.action-text {
  font-size: 28rpx;
  color: #3366ff;
  font-weight: bold;
}

.bottom-space {
  height: 100rpx;
}