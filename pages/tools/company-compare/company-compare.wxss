.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-top: env(safe-area-inset-top);
}

.content-scroll {
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
  padding-top: 48rpx;
}

.section {
  background-color: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.selected-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.selected-list {
  display: flex;
  flex-direction: column;
}

.selected-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.company-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.company-info {
  flex: 1;
}

.company-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.company-tags {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.remove-btn {
  width: 48rpx;
  height: 48rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #3366ff;
  margin-right: 12rpx;
}

.add-text {
  font-size: 28rpx;
  color: #666;
}

.weight-list {
  display: flex;
  flex-direction: column;
}

.weight-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.weight-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
}

.weight-slider {
  flex: 1;
  margin: 0 20rpx;
}

.weight-value {
  width: 80rpx;
  font-size: 26rpx;
  color: #333;
  text-align: right;
}

.compare-btn {
  margin: 40rpx 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #3366ff, #6699ff);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
}

.result-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.summary-card {
  background: linear-gradient(135deg, #f0f5ff, #e6eeff);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.summary-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.summary-list {
  display: flex;
  flex-direction: column;
}

.summary-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  position: relative;
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}

.summary-info {
  flex: 1;
}

.summary-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.summary-score {
  font-size: 24rpx;
  color: #3366ff;
  font-weight: bold;
  display: block;
  margin-top: 4rpx;
}

.summary-badge {
  background-color: #3366ff;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.compare-table {
  border: 1rpx solid #e8e8e8;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.table-header {
  display: flex;
  background-color: #f8f8f8;
  padding: 20rpx;
}

.table-row {
  display: flex;
  border-top: 1rpx solid #e8e8e8;
  padding: 20rpx;
}

.table-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}

.table-cell.label-cell {
  flex: 0 0 140rpx;
  text-align: left;
  color: #666;
}

.score-bar {
  position: relative;
  height: 24rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.score-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #3366ff, #6699ff);
  border-radius: 12rpx;
}

.score-text {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
}

.detail-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-card {
  border: 1rpx solid #e8e8e8;
  border-radius: 16rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
}

.card-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.card-info {
  flex: 1;
}

.card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.card-industry {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.card-content {
  padding: 20rpx;
}

.pros-cons {
  margin-bottom: 16rpx;
}

.pros-cons:last-child {
  margin-bottom: 0;
}

.pros-label, .cons-label {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.pros-text {
  font-size: 26rpx;
  color: #333;
}

.cons-text {
  font-size: 26rpx;
  color: #999;
}

.card-footer {
  padding: 16rpx 20rpx;
  background-color: #f8f8f8;
}

.review-count {
  font-size: 24rpx;
  color: #999;
}

.bottom-space {
  height: 100rpx;
}

/* 弹窗样式 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-content {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.picker-search {
  padding: 20rpx 32rpx;
}

.search-input {
  width: 100%;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.picker-list {
  flex: 1;
  padding: 0 32rpx 32rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.picker-info {
  flex: 1;
}

.picker-name {
  font-size: 30rpx;
  color: #333;
  display: block;
}

.picker-tags {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.no-result {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}