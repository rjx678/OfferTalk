.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-top: env(safe-area-inset-top);
}

.content-scroll {
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
  padding-top: 48rpx;
}

.section {
  background-color: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.type-list {
  display: flex;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f8f8;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
}

.type-item.active {
  background-color: #f0f5ff;
  border-color: #3366ff;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-text {
  font-size: 26rpx;
  color: #666;
}

.type-item.active .type-text {
  color: #3366ff;
  font-weight: bold;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.remove-image {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f8f8f8;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
}

.add-icon {
  font-size: 64rpx;
  color: #3366ff;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.contact-wrapper {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.contact-input {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}

.submit-btn {
  margin: 40rpx 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #3366ff, #6699ff);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
}

.history-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  padding: 24rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.type-badge {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #fff;
}

.type-badge.type-1 {
  background-color: #ff9500;
}

.type-badge.type-2 {
  background-color: #3366ff;
}

.type-badge.type-3 {
  background-color: #ff6b6b;
}

.history-status {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #fff;
}

.history-status.status-0 {
  background-color: #999;
}

.history-status.status-1 {
  background-color: #ff9500;
}

.history-status.status-2 {
  background-color: #34c759;
}

.history-status.status-3 {
  background-color: #666;
}

.history-content {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.history-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.history-reply {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background-color: #f0f5ff;
  border-radius: 12rpx;
}

.reply-icon {
  margin-right: 12rpx;
}

.reply-text {
  flex: 1;
  font-size: 26rpx;
  color: #3366ff;
}

.bottom-space {
  height: 100rpx;
}