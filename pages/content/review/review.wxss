.container {
  min-height: 100vh;
  background: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  padding-top: env(safe-area-inset-top);
}

.content-scroll {
  min-height: 100vh;
  padding-bottom: 120rpx;
  padding-top: 48rpx; /* 增加顶部间距 */
}

.review-header {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.review-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.company-info {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.company-info:hover {
  transform: translateY(-2rpx);
}

.company-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
  display: block;
}

.company-stage {
  font-size: 22rpx;
  color: #666666;
  display: block;
}

.overall-rating {
  margin-bottom: 24rpx;
  text-align: center;
}

.rating-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.rating-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.rating-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #f59e0b;
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
}

.rating-stars {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.star {
  font-size: 32rpx;
  color: #e5e7eb;
  transition: all 0.3s ease;
}

.star.active {
  color: #f59e0b;
  transform: scale(1.1);
}

.rating-count {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: #fef3c7;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #f59e0b;
}

.rating-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.rating-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rating-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.3s ease;
}

.rating-item:hover {
  transform: translateX(8rpx);
}

.rating-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
}

.rating-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
  flex: 1;
  min-width: 120rpx;
}

.rating-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #f59e0b;
  min-width: 40rpx;
  text-align: right;
}

.rating-bar {
  width: 200rpx;
  height: 12rpx;
  background: #f3f4f6;
  border-radius: 6rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.review-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.section-icon {
  font-size: 24rpx;
  display: block;
}

.section-text {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.6;
  white-space: pre-wrap;
}

.pros-section {
  border-left: 4rpx solid #52c41a;
}

.cons-section {
  border-left: 4rpx solid #ff4d4f;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.3s ease;
}

.info-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: #fef3c7;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.info-icon {
  font-size: 28rpx;
  display: block;
}

.info-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
  flex: 1;
}

.info-value {
  font-size: 22rpx;
  color: #333333;
  line-height: 1.5;
  white-space: pre-wrap;
}

.article-footer {
  background: #ffffff;
  padding: 24rpx 32rpx;
  margin: 0 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.author-name {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
  display: block;
}

.post-time {
  font-size: 20rpx;
  color: #999999;
  display: block;
}

.author-job {
  font-size: 20rpx;
  color: #999999;
  display: block;
  margin-top: 4rpx;
}

.truth-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #fef3c7;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.badge-label {
  font-size: 20rpx;
  color: #666666;
}

.badge-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #f59e0b;
}

.comment-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.section-count {
  font-size: 24rpx;
  color: #999999;
  background: #f5f5f7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.comment-item:hover {
  background: #f0f4ff;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-author {
  font-size: 22rpx;
  font-weight: 500;
  color: #333333;
}

.comment-time {
  font-size: 20rpx;
  color: #999999;
}

.comment-content {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
}

.action-item {
  font-size: 20rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 4rpx;
  transition: all 0.3s ease;
}

.action-item:hover {
  color: #3366ff;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
}

.no-comments-text {
  font-size: 24rpx;
  display: block;
}

.comment-input-area {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.comment-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 40rpx;
  font-size: 24rpx;
  background: #f8f9fa;
  line-height: 80rpx;
}

.comment-submit {
  height: 80rpx;
  padding: 0 32rpx;
  background: #3366ff;
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-submit:disabled {
  background: #e0e0e0;
  color: #999999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
  z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.action-item:hover {
  background: #fef3c7;
  transform: translateY(-2rpx);
}

.action-item.active {
  color: #f59e0b;
}

.action-icon {
  font-size: 32rpx;
  display: block;
}

.action-text {
  font-size: 20rpx;
  color: #666666;
}

.action-item.active .action-text {
  color: #f59e0b;
}

.disclaimer-bottom {
  background: #ffffff;
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
  border-top: 1rpx solid #f0f0f0;
  margin: 0 16rpx 120rpx;
  border-radius: 16rpx;
}

.quick-nav {
  position: fixed;
  right: 32rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #3366ff 0%, #5588ff 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(51, 102, 255, 0.4);
  opacity: 0;
  transform: scale(0.8) translateY(20rpx);
  transition: all 0.3s ease;
  z-index: 99;
}

.quick-nav.show {
  opacity: 1;
  transform: scale(1) translateY(0);
}

.quick-nav:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(51, 102, 255, 0.3);
}

.quick-nav-icon {
  font-size: 32rpx;
  display: block;
}

.quick-nav-text {
  font-size: 18rpx;
  color: #ffffff;
  margin-top: 2rpx;
}