.container {
  background: #fff;
}

.content {
  padding: 40rpx 30rpx 150rpx;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.company {
  color: #007AFF;
  font-weight: bold;
  margin-right: 20rpx;
}

.tag {
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
}

.section {
  margin-bottom: 50rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  border-left: 8rpx solid #007AFF;
  padding-left: 20rpx;
  margin-bottom: 25rpx;
}

.timeline-content {
  background: #f8f8f8;
  padding: 25rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.article-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.footer-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  color: #666;
  margin-right: 50rpx;
}

.icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.share-btn {
  flex: 1;
  background: #007AFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.disclaimer {
  font-size: 22rpx;
  color: #ccc;
  text-align: center;
  margin-top: 50rpx;
}
