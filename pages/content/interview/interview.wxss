.container {
  min-height: 100vh;
  background: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  padding-top: env(safe-area-inset-top);
}

.content-scroll {
  min-height: 100vh;
  padding-bottom: 120rpx;
  padding-top: 48rpx; /* 增加顶部间距 */
}

.article-header {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 24rpx; /* 增加底部间距 */
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
  margin: 0 16rpx 24rpx;
}

.article-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.article-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.meta-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #999999;
  min-width: 80rpx;
}

.meta-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

.meta-value.status-success {
  color: #52c41a;
}

.meta-value.status-danger {
  color: #ff4d4f;
}

.meta-value.status-info {
  color: #1890ff;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: #f0f4ff;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #3366ff;
}

.company-card {
  background: #ffffff;
  padding: 24rpx 32rpx;
  margin: 0 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.3s ease;
  border-radius: 16rpx;
}

.company-card:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.company-info {
  flex: 1;
}

.company-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
  display: block;
}

.company-stage {
  font-size: 22rpx;
  color: #666666;
  display: block;
}

.arrow-right {
  font-size: 36rpx;
  color: #999999;
  font-weight: 300;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.section-count {
  font-size: 24rpx;
  color: #999999;
  background: #f5f5f7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.timeline-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.timeline {
  position: relative;
  padding-left: 32rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #e0e0e0;
}

.timeline-item {
  position: relative;
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #3366ff;
  border: 4rpx solid #e8f0fe;
  z-index: 1;
}

.timeline-content {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 4rpx solid #3366ff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.3s ease;
}

.timeline-content:hover {
  transform: translateX(8rpx);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.timeline-stage {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.timeline-date {
  font-size: 20rpx;
  color: #999999;
  white-space: nowrap;
}

.timeline-result {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.timeline-result.pass {
  background: #f6ffed;
  color: #52c41a;
}

.timeline-result.fail {
  background: #fff1f0;
  color: #ff4d4f;
}

.timeline-note {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
  display: block;
}

.article-content {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.content-text {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.6;
  white-space: pre-wrap;
}

.question-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.question-item:hover {
  background: #f0f4ff;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.question-number {
  font-size: 24rpx;
  font-weight: 700;
  color: #3366ff;
  min-width: 32rpx;
  text-align: center;
}

.question-content {
  flex: 1;
  font-size: 24rpx;
  color: #333333;
  line-height: 1.5;
}

.tip-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.6;
  white-space: pre-wrap;
}

.article-footer {
  background: #ffffff;
  padding: 24rpx 32rpx;
  margin: 0 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

.post-time {
  font-size: 20rpx;
  color: #999999;
}

.truth-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #f0f4ff;
  border-radius: 12rpx;
}

.badge-label {
  font-size: 20rpx;
  color: #666666;
}

.badge-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #3366ff;
}

.comment-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.comment-item:hover {
  background: #f0f4ff;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-author {
  font-size: 22rpx;
  font-weight: 500;
  color: #333333;
}

.comment-time {
  font-size: 20rpx;
  color: #999999;
}

.comment-content {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
}

.action-item {
  font-size: 20rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 4rpx;
  transition: all 0.3s ease;
}

.action-item:hover {
  color: #3366ff;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
}

.no-comments-text {
  font-size: 24rpx;
  display: block;
}

.comment-input-area {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.comment-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 40rpx;
  font-size: 24rpx;
  background: #f8f9fa;
  line-height: 80rpx;
}

.comment-submit {
  height: 80rpx;
  padding: 0 32rpx;
  background: #3366ff;
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-submit:disabled {
  background: #e0e0e0;
  color: #999999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
  z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.action-item:hover {
  background: #f0f4ff;
  transform: translateY(-2rpx);
}

.action-item.active {
  color: #3366ff;
}

.action-icon {
  font-size: 32rpx;
  display: block;
}

.action-text {
  font-size: 20rpx;
  color: #666666;
}

.action-item.active .action-text {
  color: #3366ff;
}

.disclaimer-bottom {
  background: #ffffff;
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
  border-top: 1rpx solid #f0f0f0;
  margin: 0 16rpx 120rpx;
  border-radius: 16rpx;
}

.quick-nav {
  position: fixed;
  right: 32rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #3366ff 0%, #5588ff 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(51, 102, 255, 0.4);
  opacity: 0;
  transform: scale(0.8) translateY(20rpx);
  transition: all 0.3s ease;
  z-index: 99;
}

.quick-nav.show {
  opacity: 1;
  transform: scale(1) translateY(0);
}

.quick-nav:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(51, 102, 255, 0.3);
}

.quick-nav-icon {
  font-size: 32rpx;
  display: block;
}

.quick-nav-text {
  font-size: 18rpx;
  color: #ffffff;
  margin-top: 2rpx;
}