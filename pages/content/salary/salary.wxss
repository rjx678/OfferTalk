.container {
  height: 100vh;
  background: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

.content-scroll {
  height: calc(100vh - env(safe-area-inset-top) - 120rpx);
  padding-bottom: 280rpx;
  padding-top: 48rpx;
  box-sizing: border-box;
}

.salary-header {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.salary-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.company-info {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.company-info:hover {
  transform: translateY(-2rpx);
}

.company-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
  display: block;
}

.company-stage {
  font-size: 22rpx;
  color: #666666;
  display: block;
}

.salary-package {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.package-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #0ea5e9;
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
}

.package-unit {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.salary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #0ea5e9;
}

.salary-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.info-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: #f0f9ff;
}

.info-label {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

.info-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
}

.salary-breakdown {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.salary-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.3s ease;
}

.salary-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: #f0f9ff;
}

.salary-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.salary-item-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.salary-item-value {
  font-size: 24rpx;
  color: #0ea5e9;
  font-weight: 600;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  text-align: center;
}

.benefit-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: #f0f9ff;
}

.benefit-icon {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.benefit-label {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.benefit-value {
  font-size: 24rpx;
  color: #0ea5e9;
  font-weight: 600;
}

.additional-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-card {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.3s ease;
}

.info-card:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: #f0f9ff;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.info-icon {
  font-size: 28rpx;
  display: block;
}

.info-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
  flex: 1;
}

.info-text {
  font-size: 22rpx;
  color: #333333;
  line-height: 1.5;
  white-space: pre-wrap;
}

.article-footer {
  background: #ffffff;
  padding: 24rpx 32rpx;
  margin: 0 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

.post-time {
  font-size: 20rpx;
  color: #999999;
}

.truth-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
}

.badge-label {
  font-size: 20rpx;
  color: #666666;
}

.badge-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #0ea5e9;
}

.comment-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 0 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-radius: 16rpx;
}

.section-count {
  font-size: 24rpx;
  color: #999999;
  background: #f5f5f7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.comment-item:hover {
  background: #f0f4ff;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-author {
  font-size: 22rpx;
  font-weight: 500;
  color: #333333;
}

.comment-time {
  font-size: 20rpx;
  color: #999999;
}

.comment-content {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
}

.action-item {
  font-size: 20rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 4rpx;
  transition: all 0.3s ease;
}

.action-item:hover {
  color: #3366ff;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
}

.no-comments-text {
  font-size: 24rpx;
  display: block;
}

.comment-input-area {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.comment-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 40rpx;
  font-size: 24rpx;
  background: #f8f9fa;
  line-height: 80rpx;
}

.comment-submit {
  height: 80rpx;
  padding: 0 32rpx;
  background: #3366ff;
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-submit:disabled {
  background: #e0e0e0;
  color: #999999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
  z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.action-item:hover {
  background: #f0f9ff;
  transform: translateY(-2rpx);
}

.action-item.active {
  color: #0ea5e9;
}

.action-icon {
  font-size: 32rpx;
  display: block;
}

.action-text {
  font-size: 20rpx;
  color: #666666;
}

.action-item.active .action-text {
  color: #0ea5e9;
}

.disclaimer-bottom {
  background: #ffffff;
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
  border-top: 1rpx solid #f0f0f0;
  margin: 0 16rpx 20rpx;
  border-radius: 16rpx;
}

.bottom-spacer {
  height: 40rpx;
}