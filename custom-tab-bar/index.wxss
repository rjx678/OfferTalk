.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  transition: all 0.3s ease;
}

.icon-wrapper {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.icon, .icon-active {
  position: absolute;
  top: 0;
  left: 0;
  font-size: 44rpx;
  transition: all 0.3s ease;
}

.icon {
  opacity: 1;
  color: #999999;
}

.icon-active {
  opacity: 0;
  color: #3366ff;
}

.tab-item.active .icon {
  opacity: 0;
}

.tab-item.active .icon-active {
  opacity: 1;
}

.text {
  font-size: 22rpx;
  color: #999999;
  transition: all 0.3s ease;
}

.text.active {
  color: #3366ff;
  font-weight: 600;
}
