.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  display: flex;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 9999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item.active .label {
  color: #1a1a2e;
  font-weight: 600;
}

.icon {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 4rpx;
  transition: transform 0.2s ease;
}

.tab-item.active .icon {
  transform: scale(1.1);
}

.label {
  font-size: 22rpx;
  color: #999999;
  transition: color 0.2s ease;
}

.tab-item.active .label {
  color: #1a1a2e;
}